{
  "name": "dyc-platform",
  "version": "1.0.0",
  "description": "DY&C - Enterprise ERP and Staffing Platform",
  "private": true,
  "scripts": {
    "dev": "concurrently -n \"server,client\" -c \"blue,green\" \"npm run server\" \"npm run client\"",
    "client": "npm --prefix client run dev",
    "server": "npm --prefix server run dev",
    "install:all": "npm --prefix client install && npm --prefix server install",
    "build": "npm --prefix client run build",
    "start": "npm --prefix server start",
    "seed": "npm --prefix server run seed"
  },
  "devDependencies": {
    "concurrently": "^10.0.6"
  }
}
